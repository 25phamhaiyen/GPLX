  GioiTinh    String?      @db.NVarChar(10)
  CCCD        String?      @unique(map: "UQ__HocVien__A955A0AACF74A2C2") @db.Char(12)
  SoDienThoai String       @db.VarChar(15)
  Email       String       @unique(map: "UQ__HocVien__A9D105348736DA01") @db.NVarChar(100)
  DiaChi      String?      @db.NVarChar(255)
  NgayTao     DateTime?    @default(now(), map: "DF__HocVien__NgayTao__5EBF139D") @db.DateTime
