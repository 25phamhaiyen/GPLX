generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model HoiDongSatHach {
  MaHoiDong       Int            @id(map: "PK__HoiDongS__998808B3893A869E") @default(autoincrement())
  TenHoiDong      String         @db.NVarChar(200)
  ChuTichHoiDong  String         @db.NVarChar(100)
  ThanhVien       String?        @db.NVarChar(500)
  NgayThanhLap    DateTime?      @db.Date
  TrangThai       String?        @default("Hoạt động", map: "DF__HoiDongSa__Trang__2A164134") @db.NVarChar(20)
  DuyetCapGPLX    DuyetCapGPLX[]
}

model DuyetCapGPLX {
  MaDuyet        Int             @id(map: "PK__DuyetCap__34A9E4894E3E030B") @default(autoincrement())
  MaThongTinThi  Int             @unique(map: "UQ__DuyetCap__071809421423BEE2")
  MaHoiDong      Int
  NgayNop        DateTime        @default(now(), map: "DF__DuyetCapG__NgayN__14270015") @db.DateTime
  NgayDuyet      DateTime?       @db.DateTime
  TrangThaiDuyet String          @default("Chờ duyệt", map: "DF__DuyetCapG__Trang__151B244E") @db.NVarChar(30)
  LyDoTuChoi     String?         @db.NVarChar(500)
  NguoiDuyet     String?         @db.NVarChar(100)
  GhiChu         String?         @db.NVarChar(500)
  HoiDongSatHach HoiDongSatHach  @relation(fields: [MaHoiDong], references: [MaHoiDong], map: "FK__DuyetCapG__MaHoi__32AB8735")
  ThongTinThi    ThongTinThi     @relation(fields: [MaThongTinThi], references: [MaThongTinThi], map: "FK__DuyetCapG__MaTho__17036CC0")
  GPLX           GPLX?
}

model GiangVien {
  MaGiangVien       Int                 @id(map: "PK__GiangVie__C03BEEBAE15D1EFE") @default(autoincrement())
  HoTen             String              @db.NVarChar(100)
  SoDienThoai       String?             @db.VarChar(15)
  Email             String?             @unique(map: "UQ__GiangVie__A9D10534D98C467D") @db.NVarChar(100)
  TrangThai         String?             @default("Hoạt động", map: "DF__GiangVien__Trang__6477ECF3") @db.NVarChar(30)
  GhiChu            String?             @db.NVarChar(500)
  GiangVien_KhoaHoc GiangVien_KhoaHoc[]
}

model GiangVien_KhoaHoc {
  MaGiangVien  Int
  MaKhoaHoc    Int
  GhiChu       String?   @db.NVarChar(500)
  NgayPhanCong DateTime? @default(now(), map: "DF__GiangVien__NgayP__71D1E811") @db.Date
  TrangThai    String?   @default("Đang dạy", map: "DF__GiangVien__Trang__72C60C4A") @db.NVarChar(20)
  GiangVien    GiangVien @relation(fields: [MaGiangVien], references: [MaGiangVien], onDelete: Cascade, map: "FK__GiangVien__MaGia__74AE54BC")
  KhoaHoc      KhoaHoc   @relation(fields: [MaKhoaHoc], references: [MaKhoaHoc], onDelete: Cascade, map: "FK__GiangVien__MaKho__75A278F5")

  @@id([MaGiangVien, MaKhoaHoc], map: "PK_GiangVien_KhoaHoc")
}

model GPLX {
  SoGPLX       String       @id(map: "PK__GPLX__DB93E0138A77CFD4") @db.VarChar(20)
  MaHocVien    Int
  MaDuyet      Int          @unique(map: "UQ__GPLX__34A9E488248A3070")
  MaLoaiBang   Int
  NgayCap      DateTime     @default(dbgenerated("CONVERT([date],getdate())"), map: "DF__GPLX__NgayCap__1BC821DD") @db.Date
  NgayHetHan   DateTime     @db.Date
  NoiCap       String       @default("Sở Giao thông Vận tải", map: "DF__GPLX__NoiCap__1CBC4616") @db.NVarChar(200)
  TrangThai    String?      @default("Đang sử dụng", map: "DF__GPLX__TrangThai__1DB06A4F") @db.NVarChar(30)
  GhiChu       String?      @db.NVarChar(500)
  DuyetCapGPLX DuyetCapGPLX @relation(fields: [MaDuyet], references: [MaDuyet], onUpdate: NoAction, map: "FK__GPLX__MaDuyet__208CD6FA")
  HocVien      HocVien      @relation(fields: [MaHocVien], references: [MaHocVien], map: "FK__GPLX__MaHocVien__1F98B2C1")
  LoaiBangLai  LoaiBangLai  @relation(fields: [MaLoaiBang], references: [MaLoaiBang], map: "FK__GPLX__MaLoaiBang__2180FB33")
}

model HocVien {
